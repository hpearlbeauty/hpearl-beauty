# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://hpearlbeauty.com
NEXT_PUBLIC_WHATSAPP_NUMBER=234XXXXXXXXXX          # studio WhatsApp shown to clients (wa.me), international format, no "+"

# ---- Database (Neon Postgres). Unset = in-memory dev store ----
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# ---- Payments (server-side only; never expose secrets with NEXT_PUBLIC_) ----
NEXT_PUBLIC_PAYMENT_PROVIDER=paystack              # paystack | flutterwave
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxx
FLUTTERWAVE_WEBHOOK_HASH=xxx

# ---- WhatsApp automation (server-side only) ----
WHATSAPP_PROVIDER=none                             # meta | none (twilio/termii adapters to add when chosen)
WHATSAPP_API_TOKEN=xxx
WHATSAPP_PHONE_NUMBER_ID=xxx
WHATSAPP_BUSINESS_ACCOUNT_ID=xxx
OWNER_WHATSAPP_NUMBER=234XXXXXXXXXX                # where booking/consultation alerts go
# Approved template names (business-initiated messages outside a 24h window require these).
# Leave unset to send plain text (sandbox / open conversation window).
WHATSAPP_TEMPLATE_BOOKING_CONFIRMATION=
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER_24H=
WHATSAPP_TEMPLATE_TOUCH_UP_REMINDER_28D=
WHATSAPP_TEMPLATE_DEPOSIT_PENDING=
WHATSAPP_TEMPLATE_OWNER_NEW_BOOKING=
WHATSAPP_TEMPLATE_OWNER_CONSULTATION_REQUEST=
WHATSAPP_TEMPLATE_OWNER_DEPOSIT_ABANDONED=
WHATSAPP_TEMPLATE_OWNER_DAILY_DIGEST=

# ---- Cron (Vercel sends Authorization: Bearer <CRON_SECRET> to /api/cron/reminders) ----
CRON_SECRET=change-me

# ---- Scheduling backend ----
AVAILABILITY_PROVIDER=mock                         # mock | api
AVAILABILITY_API_URL=

# ---- Google Calendar availability (AVAILABILITY_PROVIDER=google) ----
GOOGLE_SERVICE_ACCOUNT_EMAIL=bookings@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=studio@gmail.com
# Opening hours until confirmed (ISO weekday range : open-close, comma separated). PLACEHOLDER default: Mon-Fri 10-18, Sat 10-16.
STUDIO_HOURS=1-5:10:00-18:00,6:10:00-16:00

# ---- Owner dashboard (/studio) ----
STUDIO_PASSCODE=change-me
STUDIO_SESSION_SECRET=change-me-too
